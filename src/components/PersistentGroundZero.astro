---
interface Props {
  animateOnReveal?: boolean;
}

const { animateOnReveal = false } = Astro.props;
---

<div
  class:list={[
    "persistent-ground-zero",
    animateOnReveal && "is-revealing",
  ]}
  aria-hidden="true"
>
  <p class="persistent-ground-zero__marker">
    <span class="persistent-ground-zero__graphic">
      <span class="persistent-ground-zero__code">GZ</span>
    </span>
  </p>
</div>

<style>
  .persistent-ground-zero {
    --persistent-gz-size: calc(var(--gz-circle-size) * 0.68);
    --persistent-gz-stroke-width: calc(var(--gz-circle-stroke-width) * 0.72);
    --persistent-gz-font-size: calc(var(--gz-circle-font-size) * 0.72);
    --persistent-gz-letter-spacing: calc(var(--gz-circle-letter-spacing) * 0.84);
    position: fixed;
    right: var(--page-inline-offset);
    bottom: var(--gz-circle-bottom);
    z-index: 20;
    pointer-events: none;
    mix-blend-mode: difference;
  }

  .persistent-ground-zero__marker {
    width: var(--persistent-gz-size);
    height: var(--persistent-gz-size);
    box-sizing: border-box;
    margin: 0;
    display: block;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    opacity: 0.76;
    transition: opacity 180ms ease-out;
    pointer-events: auto;
    user-select: none;
  }

  .persistent-ground-zero__graphic {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: var(--persistent-gz-stroke-width) solid #ffffff;
    border-radius: 999px;
    background: transparent;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: var(--persistent-gz-font-size);
    font-weight: 500;
    letter-spacing: var(--persistent-gz-letter-spacing);
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    font-kerning: none;
    font-variant-ligatures: none;
    font-variant-numeric: tabular-nums lining-nums;
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  .persistent-ground-zero__code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    transform: translateY(0.03em);
  }

  .persistent-ground-zero.is-revealing .persistent-ground-zero__marker {
    box-shadow: var(--gz-circle-shadow);
    animation: persistent-gz-settle 900ms cubic-bezier(0.26, 0.08, 0.18, 1)
      calc(var(--intro-image-settle-delay) + var(--intro-pre-swipe-duration)) forwards;
  }

  .persistent-ground-zero__marker:hover {
    opacity: 0.04;
  }

  @keyframes persistent-gz-settle {
    0% {
      box-shadow: var(--gz-circle-shadow);
    }

    100% {
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }
  }
</style>
