---
import ProjectCard from "./ProjectCard.astro";

interface ProjectEntry {
  title: string;
  image: string;
  descriptor: string;
  display: {
    frame: "portrait" | "landscape" | "wide" | "hero";
    slot:
      | "hero-left"
      | "portrait-right-high"
      | "wide-center"
      | "landscape-right"
      | "portrait-left"
      | "portrait-right"
      | "hero-center"
      | "portrait-right-low"
      | "landscape-left"
      | "landscape-right-low";
    objectPosition: string;
    objectFit: "cover" | "contain";
  };
}

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;

const slotMap: Record<ProjectEntry["display"]["slot"], { layoutClass: string; indexLabel: string }> = {
  "hero-left": {
    layoutClass: "col-span-12 md:col-span-7 xl:col-span-6 xl:col-start-1",
    indexLabel: "01",
  },
  "portrait-right-high": {
    layoutClass: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-9 md:mt-20 xl:mt-24",
    indexLabel: "02",
  },
  "wide-center": {
    layoutClass: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-3 md:mt-8 xl:mt-10",
    indexLabel: "03",
  },
  "landscape-right": {
    layoutClass: "col-span-12 md:col-span-6 xl:col-span-4 xl:col-start-9 xl:-mt-12",
    indexLabel: "04",
  },
  "portrait-left": {
    layoutClass: "col-span-12 md:col-span-8 xl:col-span-7 xl:col-start-1 md:mt-10 xl:mt-14",
    indexLabel: "05",
  },
  "portrait-right": {
    layoutClass: "col-span-12 md:col-span-4 xl:col-span-3 xl:col-start-10 md:mt-24 xl:mt-28",
    indexLabel: "06",
  },
  "hero-center": {
    layoutClass: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-2 md:mt-6 xl:mt-8",
    indexLabel: "07",
  },
  "portrait-right-low": {
    layoutClass: "col-span-12 md:col-span-7 xl:col-span-6 xl:col-start-7 md:mt-16 xl:mt-20",
    indexLabel: "08",
  },
  "landscape-left": {
    layoutClass: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-1 md:mt-12 xl:mt-16",
    indexLabel: "09",
  },
  "landscape-right-low": {
    layoutClass: "col-span-12 md:col-span-6 xl:col-span-4 xl:col-start-8 md:mt-28 xl:mt-32",
    indexLabel: "10",
  },
};

const frameMap: Record<ProjectEntry["display"]["frame"], string> = {
  portrait: "aspect-[4/5] md:aspect-[4/5]",
  landscape: "aspect-[5/4] md:aspect-[5/4]",
  wide: "aspect-[16/10] md:aspect-[16/10]",
  hero: "aspect-[4/3] md:aspect-[4/3]",
};
---

<section class="px-6 pb-28 pt-8 sm:px-10 sm:pb-36 lg:px-14">
  <div class="mx-auto max-w-[96rem]">
    <div class="grid gap-8 border-t border-black/8 pt-10 md:grid-cols-12 md:gap-x-8 md:gap-y-20 lg:pt-12 xl:gap-x-10 xl:gap-y-24">
      {
        projects.map((project) => {
          const slot = slotMap[project.display.slot];
          const frameClass = frameMap[project.display.frame];

          return (
            <ProjectCard
              title={project.title}
              image={project.image}
              descriptor={project.descriptor}
              indexLabel={slot.indexLabel}
              layoutClass={slot.layoutClass}
              frameClass={frameClass}
              objectPosition={project.display.objectPosition}
              objectFit={project.display.objectFit}
            />
          );
        })
      }
    </div>
  </div>
</section>
