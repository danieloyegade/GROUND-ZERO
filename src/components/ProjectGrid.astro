---
import ProjectCard from "./ProjectCard.astro";

interface ProjectEntry {
  title: string;
  image: string;
  descriptor: string;
  display: {
    orientation: "portrait" | "landscape" | "wide";
    cropFocus: "center" | "top" | "upper-third";
    size: "small" | "medium" | "large" | "hero";
  };
}

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;

const placementPattern: Array<Record<ProjectEntry["display"]["size"], string>> = [
  {
    small: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-1",
    medium: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-1",
    large: "col-span-12 md:col-span-7 xl:col-span-6 xl:col-start-1",
    hero: "col-span-12 md:col-span-8 xl:col-span-7 xl:col-start-1",
  },
  {
    small: "col-span-12 md:col-span-4 xl:col-span-3 xl:col-start-9 md:mt-14 xl:mt-18",
    medium: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-8 md:mt-16 xl:mt-20",
    large: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-8 md:mt-18 xl:mt-22",
    hero: "col-span-12 md:col-span-7 xl:col-span-5 xl:col-start-8 md:mt-20 xl:mt-24",
  },
  {
    small: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-3 md:mt-4 xl:mt-6",
    medium: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-3 md:mt-4 xl:mt-6",
    large: "col-span-12 md:col-span-7 xl:col-span-6 xl:col-start-2 md:mt-5 xl:mt-8",
    hero: "col-span-12 md:col-span-8 xl:col-span-7 xl:col-start-2 md:mt-6 xl:mt-9",
  },
  {
    small: "col-span-12 md:col-span-5 xl:col-span-3 xl:col-start-9 xl:-mt-8",
    medium: "col-span-12 md:col-span-6 xl:col-span-4 xl:col-start-8 xl:-mt-10",
    large: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-8 xl:-mt-10",
    hero: "col-span-12 md:col-span-7 xl:col-span-5 xl:col-start-8 xl:-mt-8",
  },
  {
    small: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-1 md:mt-10 xl:mt-14",
    medium: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-1 md:mt-10 xl:mt-14",
    large: "col-span-12 md:col-span-7 xl:col-span-6 xl:col-start-1 md:mt-12 xl:mt-16",
    hero: "col-span-12 md:col-span-8 xl:col-span-7 xl:col-start-1 md:mt-14 xl:mt-18",
  },
  {
    small: "col-span-12 md:col-span-4 xl:col-span-3 xl:col-start-9 md:mt-18 xl:mt-22",
    medium: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-8 md:mt-20 xl:mt-24",
    large: "col-span-12 md:col-span-6 xl:col-span-4 xl:col-start-8 md:mt-22 xl:mt-26",
    hero: "col-span-12 md:col-span-7 xl:col-span-5 xl:col-start-8 md:mt-22 xl:mt-28",
  },
  {
    small: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-2 md:mt-4 xl:mt-6",
    medium: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-2 md:mt-4 xl:mt-6",
    large: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-2 md:mt-6 xl:mt-8",
    hero: "col-span-12 md:col-span-7 xl:col-span-6 xl:col-start-2 md:mt-8 xl:mt-10",
  },
  {
    small: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-8 md:mt-12 xl:mt-16",
    medium: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-7 md:mt-14 xl:mt-18",
    large: "col-span-12 md:col-span-7 xl:col-span-6 xl:col-start-7 md:mt-14 xl:mt-18",
    hero: "col-span-12 md:col-span-8 xl:col-span-7 xl:col-start-6 md:mt-16 xl:mt-20",
  },
  {
    small: "col-span-12 md:col-span-5 xl:col-span-4 xl:col-start-1 md:mt-10 xl:mt-14",
    medium: "col-span-12 md:col-span-6 xl:col-span-5 xl:col-start-1 md:mt-10 xl:mt-14",
    large: "col-span-12 md:col-span-7 xl:col-span-6 xl:col-start-1 md:mt-12 xl:mt-16",
