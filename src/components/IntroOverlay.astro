---
const floorLabels = [
  {
    text: "EIGHTH FLOOR",
    style: "top: 12%; --label-delay: 0ms; --label-duration: 1150ms;",
  },
  {
    text: "FOURTH FLOOR",
    style: "top: 28%; --label-delay: 1150ms; --label-duration: 1000ms;",
  },
  {
    text: "FIRST FLOOR",
    style: "top: 44%; --label-delay: 2150ms; --label-duration: 925ms;",
  },
  {
    text: "GROUND FLOOR",
    style: "top: 60%; --label-delay: 3075ms; --label-duration: 975ms;",
  },
  {
    text: "GROUND ZERO",
    style: "bottom: 7%; --label-delay: 4050ms; --label-duration: 1650ms;",
  },
];
---

<div
  class="intro-overlay"
  data-intro-overlay
  data-ready="false"
  aria-hidden="true"
  style="--image-settle-delay: 220ms; --pre-swipe-duration: 5700ms; --swipe-duration: 800ms;"
>
  <div class="intro-overlay__image-wrap">
    <img
      src="/images/intro-image.jpg"
      alt=""
      class="intro-overlay__image"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="intro-overlay__scrim"></div>
  </div>

  <div class="intro-overlay__labels">
    {
      floorLabels.map((label, index) => (
        <p
          class={`intro-overlay__label ${index === floorLabels.length - 1 ? "is-final" : ""}`}
          style={label.style}
        >
          {label.text}
        </p>
      ))
    }
  </div>
</div>

<script is:inline>
  const overlay = document.querySelector("[data-intro-overlay]");
  const image = overlay?.querySelector(".intro-overlay__image");

  const markReady = () => {
    if (!overlay || overlay.getAttribute("data-ready") === "true") return;

    requestAnimationFrame(() => {
      overlay.setAttribute("data-ready", "true");
    });
  };

  const waitForDecode = () => {
    if (!image) {
      markReady();
      return;
    }

    if (typeof image.decode === "function") {
      image.decode().catch(() => {}).finally(markReady);
      return;
    }

    markReady();
  };

  if (image?.complete && image.naturalWidth > 0) {
    waitForDecode();
  } else if (image) {
    image.addEventListener("load", waitForDecode, { once: true });
    image.addEventListener("error", markReady, { once: true });
  } else {
    markReady();
  }
</script>

<style>
  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    background: #050505;
    will-change: transform, visibility;
  }

  .intro-overlay__image-wrap,
  .intro-overlay__image,
  .intro-overlay__scrim,
  .intro-overlay__labels {
    position: absolute;
    inset: 0;
  }

  .intro-overlay__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 260ms ease-out;
  }

  .intro-overlay__scrim {
    background:
      linear-gradient(to bottom, rgba(10, 10, 10, 0.32), rgba(10, 10, 10, 0.2)),
      linear-gradient(to right, rgba(10, 10, 10, 0.12), rgba(10, 10, 10, 0));
    opacity: 0;
    transition: opacity 260ms ease-out;
  }

  .intro-overlay__labels {
    --rail-inline-end: var(--page-inline-offset);
    --rail-width: clamp(16.5rem, 25vw, 21.5rem);
    padding: clamp(1.5rem, 3vw, 3rem);
  }

  .intro-overlay__label {
    position: absolute;
    right: var(--rail-inline-end);
    width: min(var(--rail-width), calc(100vw - (var(--rail-inline-end) * 2)));
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: clamp(1.56rem, 3.1vw, 3.02rem);
    font-weight: 500;
    letter-spacing: 0.152em;
    line-height: 0.96;
    text-align: right;
    text-transform: uppercase;
    color: rgba(247, 243, 235, 0.96);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.16), 0 2px 8px rgba(0, 0, 0, 0.16);
    font-kerning: none;
    font-variant-ligatures: none;
    transform-origin: 100% 50%;
    will-change: opacity, transform, filter;
    opacity: 0;
    filter: blur(0.24rem);
    transform: translate3d(0, -0.95rem, 0);
  }

  .intro-overlay[data-ready="true"] .intro-overlay__image,
  .intro-overlay[data-ready="true"] .intro-overlay__scrim {
    opacity: 1;
  }

  .intro-overlay[data-ready="true"] {
    animation: intro-plane-swipe var(--swipe-duration) cubic-bezier(0.42, 0, 0.18, 1)
      calc(var(--image-settle-delay) + var(--pre-swipe-duration)) forwards;
  }

  .intro-overlay[data-ready="true"] .intro-overlay__label {
    animation: intro-label var(--label-duration) cubic-bezier(0.32, 0, 0.18, 1)
      calc(var(--image-settle-delay) + var(--label-delay)) forwards;
  }

  .intro-overlay[data-ready="true"] .intro-overlay__label.is-final {
    animation: intro-final-label var(--label-duration) cubic-bezier(0.32, 0, 0.18, 1)
      calc(var(--image-settle-delay) + var(--label-delay)) forwards;
  }

  @keyframes intro-label {
    0% {
      opacity: 0;
      filter: blur(0.24rem);
      transform: translate3d(0, -1.05rem, 0);
    }

    16% {
      opacity: 0.44;
      filter: blur(0.12rem);
      transform: translate3d(0, -0.46rem, 0);
    }

    30%,
    70% {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }

    86% {
      opacity: 0.42;
      filter: blur(0.08rem);
      transform: translate3d(0, 0.18rem, 0);
    }

    100% {
      opacity: 0;
      filter: blur(0.2rem);
      transform: translate3d(0, 0.62rem, 0);
    }
  }

  @keyframes intro-final-label {
    0% {
      opacity: 0;
      filter: blur(0.24rem);
      transform: translate3d(0, -1.05rem, 0);
    }

    16% {
      opacity: 0.48;
      filter: blur(0.11rem);
      transform: translate3d(0, -0.36rem, 0);
    }

    30%,
    100% {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes intro-plane-swipe {
    0% {
      transform: translate3d(0, 0, 0);
      visibility: visible;
    }

    99% {
      transform: translate3d(0, -100vh, 0);
      visibility: visible;
    }

    100% {
      transform: translate3d(0, -100vh, 0);
      visibility: hidden;
      pointer-events: none;
    }
  }

  @media (max-width: 40rem) {
    .intro-overlay__labels {
      --rail-width: min(18rem, calc(100vw - 2.5rem));
    }

    .intro-overlay__label {
      font-size: clamp(1.44rem, 7.2vw, 1.9rem);
      letter-spacing: 0.142em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-overlay {
      animation: none;
      visibility: hidden;
      pointer-events: none;
    }

    .intro-overlay__label {
      animation: none;
      opacity: 0;
    }
  }
</style>
