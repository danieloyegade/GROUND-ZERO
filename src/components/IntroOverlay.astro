---
const floorLabels = [
  {
    code: "8TH",
    style: "top: 10%; --label-delay: 2040ms; --label-duration: 1120ms;",
  },
  {
    code: "4TH",
    style: "top: 25.5%; --label-delay: 2920ms; --label-duration: 1080ms;",
  },
  {
    code: "1ST",
    style: "top: 41%; --label-delay: 3800ms; --label-duration: 1060ms;",
  },
  {
    code: "G",
    style: "top: 56.5%; --label-delay: 4660ms; --label-duration: 1090ms;",
  },
  {
    code: "GZ",
    style: "bottom: 4.5%; --label-delay: 5520ms; --label-duration: 2280ms;",
  },
];
---

<div
  class="intro-overlay"
  data-intro-overlay
  data-ready="false"
  aria-hidden="true"
>
  <div class="intro-overlay__image-wrap">
    <img
      src="/images/intro-image.jpg"
      alt=""
      class="intro-overlay__image"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="intro-overlay__scrim"></div>
  </div>

  <div class="intro-overlay__labels">
    {
      floorLabels.map((label, index) => (
        <p
          class={`intro-overlay__label ${index === 0 ? "is-first" : ""} ${index === floorLabels.length - 1 ? "is-final" : ""}`}
          style={label.style}
        >
          <span class="intro-overlay__label-code">{label.code}</span>
        </p>
      ))
    }
  </div>
</div>

<script is:inline>
  const overlay = document.querySelector("[data-intro-overlay]");
  const image = overlay?.querySelector(".intro-overlay__image");

  const markReady = () => {
    if (!overlay || overlay.getAttribute("data-ready") === "true") return;

    requestAnimationFrame(() => {
      overlay.setAttribute("data-ready", "true");
    });
  };

  const waitForDecode = () => {
    if (!image) {
      markReady();
      return;
    }

    if (typeof image.decode === "function") {
      image.decode().catch(() => {}).finally(markReady);
      return;
    }

    markReady();
  };

  if (image?.complete && image.naturalWidth > 0) {
    waitForDecode();
  } else if (image) {
    image.addEventListener("load", waitForDecode, { once: true });
    image.addEventListener("error", markReady, { once: true });
  } else {
    markReady();
  }
</script>

<style>
  .intro-overlay {
    --image-settle-delay: var(--intro-image-settle-delay);
    --pulse-duration: var(--intro-ready-pulse-duration);
    --pre-swipe-duration: var(--intro-pre-swipe-duration);
    --swipe-duration: var(--intro-swipe-duration);
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    background: #050505;
    will-change: transform, visibility;
  }

  .intro-overlay__image-wrap,
  .intro-overlay__image,
  .intro-overlay__scrim,
  .intro-overlay__labels {
    position: absolute;
    inset: 0;
  }

  .intro-overlay__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 260ms ease-out;
  }

  .intro-overlay__scrim {
    background:
      linear-gradient(to bottom, rgba(10, 10, 10, 0.32), rgba(10, 10, 10, 0.2)),
      linear-gradient(to right, rgba(10, 10, 10, 0.12), rgba(10, 10, 10, 0));
    opacity: 0;
    transition: opacity 260ms ease-out;
  }

  .intro-overlay__labels {
    --rail-inline-end: var(--page-inline-offset);
    padding: 0;
  }

  .intro-overlay__label {
    position: absolute;
    right: var(--rail-inline-end);
    display: grid;
    place-items: center;
    width: var(--gz-circle-size);
    height: var(--gz-circle-size);
    box-sizing: border-box;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--gz-circle-font-size);
    font-weight: 500;
    letter-spacing: var(--gz-circle-letter-spacing);
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    color: rgba(247, 243, 235, 0.96);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.14), 0 2px 10px rgba(0, 0, 0, 0.14);
    font-kerning: none;
    font-variant-ligatures: none;
    font-variant-numeric: tabular-nums lining-nums;
    border: var(--gz-circle-stroke-width) solid rgba(247, 243, 235, 0.84);
    border-radius: 999px;
    background: rgba(9, 9, 9, 0.05);
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    transform-origin: 100% 50%;
    will-change: opacity, transform, filter, box-shadow;
    opacity: 0;
    filter: blur(0.09rem);
    transform: translate3d(0, -1.1rem, 0);
  }

  .intro-overlay__label-code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    transform: translateY(0.03em);
  }

  .intro-overlay[data-ready="true"] .intro-overlay__image,
  .intro-overlay[data-ready="true"] .intro-overlay__scrim {
    opacity: 1;
  }

  .intro-overlay[data-ready="true"] {
    animation: intro-plane-swipe var(--swipe-duration) cubic-bezier(0.42, 0, 0.18, 1)
      calc(var(--image-settle-delay) + var(--pre-swipe-duration)) forwards;
  }

  .intro-overlay[data-ready="true"] .intro-overlay__label {
    animation: intro-label var(--label-duration) cubic-bezier(0.28, 0.02, 0.18, 1)
      calc(var(--image-settle-delay) + var(--label-delay)) forwards;
  }

  .intro-overlay[data-ready="true"] .intro-overlay__label.is-first {
    animation:
      intro-ready-pulse var(--pulse-duration) cubic-bezier(0.34, 0.06, 0.22, 1)
        calc(var(--image-settle-delay) + 120ms) 1 both,
      intro-first-label var(--label-duration) cubic-bezier(0.28, 0.02, 0.18, 1)
        calc(var(--image-settle-delay) + var(--label-delay)) forwards;
  }

  .intro-overlay[data-ready="true"] .intro-overlay__label.is-final {
    animation: intro-final-label var(--label-duration) cubic-bezier(0.28, 0.02, 0.18, 1)
      calc(var(--image-settle-delay) + var(--label-delay)) forwards;
  }

  @keyframes intro-ready-pulse {
    0% {
      opacity: 0.22;
      filter: blur(0.03rem);
      transform: translate3d(0, 0, 0) scale(0.988);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }

    18% {
      opacity: 0.48;
      filter: blur(0.012rem);
      transform: translate3d(0, 0, 0) scale(1.018);
    }

    34%,
    58% {
      opacity: 0.24;
      filter: blur(0.024rem);
      transform: translate3d(0, 0, 0) scale(1);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }

    78% {
      opacity: 0.5;
      filter: blur(0.01rem);
      transform: translate3d(0, 0, 0) scale(1.018);
    }

    100% {
      opacity: 0.24;
      filter: blur(0.024rem);
      transform: translate3d(0, 0, 0) scale(1);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }
  }

  @keyframes intro-first-label {
    0% {
      opacity: 0.24;
      filter: blur(0.024rem);
      transform: translate3d(0, 0, 0) scale(1);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }

    18% {
      opacity: 0.78;
      filter: blur(0.012rem);
      transform: translate3d(0, -0.04rem, 0) scale(1);
    }

    30%,
    56% {
      opacity: 0.94;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1);
    }

    74% {
      opacity: 0.58;
      filter: blur(0.012rem);
      transform: translate3d(0, 0.03rem, 0) scale(1);
    }

    90% {
      opacity: 0.18;
      filter: blur(0.028rem);
      transform: translate3d(0, 0.18rem, 0) scale(1);
    }

    100% {
      opacity: 0;
      filter: blur(0.042rem);
      transform: translate3d(0, 0.46rem, 0) scale(1);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }
  }

  @keyframes intro-label {
    0% {
      opacity: 0;
      filter: blur(0.09rem);
      transform: translate3d(0, -1.18rem, 0);
    }

    10% {
      opacity: 0.34;
      filter: blur(0.05rem);
      transform: translate3d(0, -0.68rem, 0);
    }

    22% {
      opacity: 0.88;
      filter: blur(0.018rem);
      transform: translate3d(0, -0.12rem, 0);
    }

    32%,
    58% {
      opacity: 0.94;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }

    74% {
      opacity: 0.62;
      filter: blur(0.012rem);
      transform: translate3d(0, 0.04rem, 0);
    }

    90% {
      opacity: 0.2;
      filter: blur(0.035rem);
      transform: translate3d(0, 0.2rem, 0);
    }

    100% {
      opacity: 0;
      filter: blur(0.05rem);
      transform: translate3d(0, 0.54rem, 0);
    }
  }

  @keyframes intro-final-label {
    0% {
      opacity: 0;
      filter: blur(0.08rem);
      transform: translate3d(0, -1.08rem, 0) scale(0.988);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }

    14% {
      opacity: 0.36;
      filter: blur(0.044rem);
      transform: translate3d(0, -0.56rem, 0) scale(0.994);
    }

    28% {
      opacity: 0.9;
      filter: blur(0.016rem);
      transform: translate3d(0, -0.06rem, 0) scale(1);
    }

    40% {
      opacity: 0.96;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }

    54% {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1.028);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }

    64% {
      opacity: 0.96;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }

    78% {
      opacity: 0.96;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1);
      box-shadow: var(--gz-circle-shadow);
    }

    100% {
      opacity: 0.96;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1);
      box-shadow: var(--gz-circle-shadow);
    }
  }

  @keyframes intro-plane-swipe {
    0% {
      transform: translate3d(0, 0, 0);
      visibility: visible;
    }

    99% {
      transform: translate3d(0, -100vh, 0);
      visibility: visible;
    }

    100% {
      transform: translate3d(0, -100vh, 0);
      visibility: hidden;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-overlay {
      animation: none;
      visibility: hidden;
      pointer-events: none;
    }

    .intro-overlay__label {
      animation: none;
      opacity: 0;
    }
  }
</style>
