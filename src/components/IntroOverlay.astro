---
const floorLabels = [
  {
    text: "EIGHTH FLOOR",
    style:
      "top: 13%; right: clamp(1.5rem, 4vw, 4rem); --label-delay: 0ms; --label-duration: 1000ms;",
  },
  {
    text: "FOURTH FLOOR",
    style:
      "top: 28%; right: clamp(1.5rem, 4vw, 4rem); --label-delay: 1000ms; --label-duration: 900ms;",
  },
  {
    text: "FIRST FLOOR",
    style:
      "top: 44%; right: clamp(1.5rem, 4vw, 4rem); --label-delay: 1900ms; --label-duration: 900ms;",
  },
  {
    text: "GROUND FLOOR",
    style:
      "top: 60%; right: clamp(1.5rem, 4vw, 4rem); --label-delay: 2800ms; --label-duration: 900ms;",
  },
  {
    text: "GROUND ZERO",
    style:
      "right: clamp(1.5rem, 4vw, 4rem); bottom: 10%; --label-delay: 3700ms; --label-duration: 2000ms;",
  },
];
---

<div
  class="intro-overlay"
  aria-hidden="true"
  style="--pre-swipe-duration: 5700ms; --swipe-duration: 800ms;"
>
  <div class="intro-overlay__image-wrap">
    <img
      src="/images/intro-image.jpg"
      alt=""
      class="intro-overlay__image"
      loading="eager"
      decoding="async"
    />
    <div class="intro-overlay__scrim"></div>
  </div>

  <div class="intro-overlay__labels">
    {
      floorLabels.map((label, index) => (
        <p
          class={`intro-overlay__label ${index === floorLabels.length - 1 ? "is-final" : ""}`}
          style={label.style}
        >
          {label.text}
        </p>
      ))
    }
  </div>
</div>

<style>
  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    animation: intro-plane-swipe var(--swipe-duration) cubic-bezier(0.42, 0, 0.18, 1)
      var(--pre-swipe-duration) forwards;
    will-change: transform, visibility;
  }

  .intro-overlay__image-wrap,
  .intro-overlay__image,
  .intro-overlay__scrim,
  .intro-overlay__labels {
    position: absolute;
    inset: 0;
  }

  .intro-overlay__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro-overlay__scrim {
    background:
      linear-gradient(to bottom, rgba(10, 10, 10, 0.32), rgba(10, 10, 10, 0.2)),
      linear-gradient(to right, rgba(10, 10, 10, 0.12), rgba(10, 10, 10, 0));
  }

  .intro-overlay__labels {
    padding: clamp(1.5rem, 3vw, 3rem);
  }

  .intro-overlay__label {
    position: absolute;
    width: min(20rem, calc(100vw - 3rem));
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.15rem, 2.4vw, 2.35rem);
    font-weight: 500;
    letter-spacing: 0.15em;
    line-height: 0.98;
    text-align: right;
    text-transform: uppercase;
    color: rgba(247, 243, 235, 0.96);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.14), 0 3px 12px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translate3d(0, -0.8rem, 0);
    animation: intro-label var(--label-duration) cubic-bezier(0.32, 0, 0.18, 1)
      var(--label-delay) forwards;
  }

  .intro-overlay__label.is-final {
    animation: intro-final-label var(--label-duration) cubic-bezier(0.32, 0, 0.18, 1)
      var(--label-delay) forwards;
  }

  @keyframes intro-label {
    0% {
      opacity: 0;
      transform: translate3d(0, -0.8rem, 0);
    }

    22%,
    78% {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }

    100% {
      opacity: 0;
      transform: translate3d(0, 0.55rem, 0);
    }
  }

  @keyframes intro-final-label {
    0% {
      opacity: 0;
      transform: translate3d(0, -0.8rem, 0);
    }

    18%,
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes intro-plane-swipe {
    0% {
      transform: translate3d(0, 0, 0);
      visibility: visible;
    }

    99% {
      transform: translate3d(0, -100vh, 0);
      visibility: visible;
    }

    100% {
      transform: translate3d(0, -100vh, 0);
      visibility: hidden;
      pointer-events: none;
    }
  }

  @media (max-width: 40rem) {
    .intro-overlay__label {
      letter-spacing: 0.14em;
      width: min(16rem, calc(100vw - 2.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-overlay {
      animation: none;
      visibility: hidden;
      pointer-events: none;
    }

    .intro-overlay__label {
      animation: none;
      opacity: 0;
    }
  }
</style>
