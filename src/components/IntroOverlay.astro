---
const floorLabels = [
  {
    text: "EIGHTH FLOOR",
    style: "top: 8.25%; --label-delay: 0ms; --label-duration: 1280ms;",
  },
  {
    text: "FOURTH FLOOR",
    style: "top: 24.25%; --label-delay: 1280ms; --label-duration: 1110ms;",
  },
  {
    text: "FIRST FLOOR",
    style: "top: 40.25%; --label-delay: 2390ms; --label-duration: 1060ms;",
  },
  {
    text: "GROUND FLOOR",
    style: "top: 56.25%; --label-delay: 3450ms; --label-duration: 1090ms;",
  },
  {
    text: "GROUND ZERO",
    style: "bottom: 4.25%; --label-delay: 4540ms; --label-duration: 1900ms;",
  },
];
---

<div
  class="intro-overlay"
  data-intro-overlay
  data-ready="false"
  aria-hidden="true"
  style="--image-settle-delay: 220ms; --pre-swipe-duration: 6540ms; --swipe-duration: 800ms;"
>
  <div class="intro-overlay__image-wrap">
    <img
      src="/images/intro-image.jpg"
      alt=""
      class="intro-overlay__image"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="intro-overlay__scrim"></div>
  </div>

  <div class="intro-overlay__labels">
    {
      floorLabels.map((label, index) => (
        <p
          class={`intro-overlay__label ${index === floorLabels.length - 1 ? "is-final" : ""}`}
          style={label.style}
        >
          {label.text}
        </p>
      ))
    }
  </div>
</div>

<script is:inline>
  const overlay = document.querySelector("[data-intro-overlay]");
  const image = overlay?.querySelector(".intro-overlay__image");

  const markReady = () => {
    if (!overlay || overlay.getAttribute("data-ready") === "true") return;

    requestAnimationFrame(() => {
      overlay.setAttribute("data-ready", "true");
    });
  };

  const waitForDecode = () => {
    if (!image) {
      markReady();
      return;
    }

    if (typeof image.decode === "function") {
      image.decode().catch(() => {}).finally(markReady);
      return;
    }

    markReady();
  };

  if (image?.complete && image.naturalWidth > 0) {
    waitForDecode();
  } else if (image) {
    image.addEventListener("load", waitForDecode, { once: true });
    image.addEventListener("error", markReady, { once: true });
  } else {
    markReady();
  }
</script>

<style>
  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    background: #050505;
    will-change: transform, visibility;
  }

  .intro-overlay__image-wrap,
  .intro-overlay__image,
  .intro-overlay__scrim,
  .intro-overlay__labels {
    position: absolute;
    inset: 0;
  }

  .intro-overlay__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 260ms ease-out;
  }

  .intro-overlay__scrim {
    background:
      linear-gradient(to bottom, rgba(10, 10, 10, 0.32), rgba(10, 10, 10, 0.2)),
      linear-gradient(to right, rgba(10, 10, 10, 0.12), rgba(10, 10, 10, 0));
    opacity: 0;
    transition: opacity 260ms ease-out;
  }

  .intro-overlay__labels {
    --rail-inline-end: var(--page-inline-offset);
    --rail-width: clamp(28rem, 49vw, 50rem);
    padding: 0;
  }

  .intro-overlay__label {
    position: absolute;
    right: var(--rail-inline-end);
    width: min(var(--rail-width), calc(100vw - (var(--rail-inline-end) * 2)));
    box-sizing: border-box;
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: clamp(2.75rem, 5.45vw, 5.9rem);
    font-weight: 500;
    letter-spacing: 0.094em;
    line-height: 0.82;
    text-align: right;
    text-transform: uppercase;
    color: rgba(247, 243, 235, 0.96);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.14), 0 2px 10px rgba(0, 0, 0, 0.14);
    font-kerning: none;
    font-variant-ligatures: none;
    transform-origin: 100% 50%;
    will-change: opacity, transform, filter;
    opacity: 0;
    filter: blur(0.16rem);
    transform: translate3d(0, -1.7rem, 0);
  }

  .intro-overlay[data-ready="true"] .intro-overlay__image,
  .intro-overlay[data-ready="true"] .intro-overlay__scrim {
    opacity: 1;
  }

  .intro-overlay[data-ready="true"] {
    animation: intro-plane-swipe var(--swipe-duration) cubic-bezier(0.42, 0, 0.18, 1)
      calc(var(--image-settle-delay) + var(--pre-swipe-duration)) forwards;
  }

  .intro-overlay[data-ready="true"] .intro-overlay__label {
    animation: intro-label var(--label-duration) cubic-bezier(0.28, 0.02, 0.18, 1)
      calc(var(--image-settle-delay) + var(--label-delay)) forwards;
  }

  .intro-overlay[data-ready="true"] .intro-overlay__label.is-final {
    animation: intro-final-label var(--label-duration) cubic-bezier(0.28, 0.02, 0.18, 1)
      calc(var(--image-settle-delay) + var(--label-delay)) forwards;
  }

  @keyframes intro-label {
    0% {
      opacity: 0;
      filter: blur(0.16rem);
      transform: translate3d(0, -1.95rem, 0);
    }

    12% {
      opacity: 0.6;
      filter: blur(0.095rem);
      transform: translate3d(0, -0.92rem, 0);
    }

    28%,
    66% {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }

    82% {
      opacity: 0.58;
      filter: blur(0.07rem);
      transform: translate3d(0, 0.34rem, 0);
    }

    100% {
      opacity: 0;
      filter: blur(0.1rem);
      transform: translate3d(0, 1.18rem, 0);
    }
  }

  @keyframes intro-final-label {
    0% {
      opacity: 0;
      filter: blur(0.16rem);
      transform: translate3d(0, -1.95rem, 0);
    }

    12% {
      opacity: 0.66;
      filter: blur(0.09rem);
      transform: translate3d(0, -0.9rem, 0);
    }

    28%,
    100% {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes intro-plane-swipe {
    0% {
      transform: translate3d(0, 0, 0);
      visibility: visible;
    }

    99% {
      transform: translate3d(0, -100vh, 0);
      visibility: visible;
    }

    100% {
      transform: translate3d(0, -100vh, 0);
      visibility: hidden;
      pointer-events: none;
    }
  }

  @media (max-width: 40rem) {
    .intro-overlay__labels {
      --rail-width: min(23.5rem, calc(100vw - 2.5rem));
    }

    .intro-overlay__label {
      font-size: clamp(1.95rem, 8.7vw, 2.75rem);
      letter-spacing: 0.088em;
      line-height: 0.84;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-overlay {
      animation: none;
      visibility: hidden;
      pointer-events: none;
    }

    .intro-overlay__label {
      animation: none;
      opacity: 0;
    }
  }
</style>
