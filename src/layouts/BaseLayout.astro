---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "GROUND ZERO is a minimal editorial portfolio built with Astro.",
} = Astro.props;

const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
  </head>
  <body class="bg-[var(--page-background)] text-[var(--page-foreground)] antialiased">
    <div class="min-h-screen">
      <header class="fixed inset-x-0 top-0 z-20 border-b border-black/6 bg-[color:rgba(245,241,232,0.92)]">
        <nav class="mx-auto flex w-full max-w-[96rem] items-center justify-between px-6 py-5 sm:px-10 lg:px-14">
          <a
            href="/"
            class="text-[0.72rem] font-medium uppercase tracking-[0.28em] text-[var(--page-foreground)] transition-colors hover:text-black"
          >
            GROUND ZERO
          </a>
          <a
            href="/information"
            class="text-[0.72rem] uppercase tracking-[0.28em] text-[var(--muted-foreground)] transition-colors hover:text-[var(--page-foreground)]"
          >
            Information
          </a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
