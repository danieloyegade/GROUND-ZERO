---
import "../styles/global.css";
import PersistentGroundZero from "../components/PersistentGroundZero.astro";

interface Props {
  title: string;
  description?: string;
  preloadImage?: string;
}

const {
  title,
  description = "GROUND ZERO is a minimal editorial portfolio built with Astro.",
  preloadImage,
} = Astro.props;
const pathname = Astro.url.pathname;
const isSelectedWorkPage = pathname === "/" || pathname.startsWith("/selected-work");
const isInformationPage = pathname.startsWith("/information");
const shouldAnimatePersistentGroundZero = pathname === "/";
const showPersistentGroundZero = pathname === "/" || pathname === "/selected-work" || pathname === "/selected-work/";

const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
    <title>{title}</title>
  </head>
  <body class="bg-[var(--page-background)] text-[var(--page-foreground)] antialiased">
    <div class="min-h-screen">
      <header class="site-header">
        <nav class="site-header__nav" aria-label="Primary">
          <a
            href="/"
            class="site-header__link site-header__link--brand"
          >
            GROUND ZERO
          </a>
          <a
            href="/selected-work"
            class:list={[
              "site-header__link site-header__link--work",
              isSelectedWorkPage && "is-active",
            ]}
          >
            Selected Works
          </a>
          <a
            href="/information"
            class:list={[
              "site-header__link site-header__link--information",
              isInformationPage && "is-active",
            ]}
          >
            Information
          </a>
        </nav>
      </header>
      {showPersistentGroundZero && (
        <PersistentGroundZero animateOnReveal={shouldAnimatePersistentGroundZero} />
      )}
      <main class="site-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    pointer-events: none;
    mix-blend-mode: difference;
  }

  .site-header__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: baseline;
    gap: clamp(0.65rem, 1.6vw, 1.6rem);
    max-width: var(--page-max-width);
    margin: 0 auto;
    min-height: var(--header-clearance);
    padding: 0.94rem var(--page-inline-padding) 0.66rem;
    pointer-events: auto;
  }

  .site-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: clamp(0.8rem, 0.69rem + 0.24vw, 1.1rem);
    font-weight: 700;
    font-synthesis: weight;
    letter-spacing: 0.102em;
    line-height: 0.9;
    text-transform: uppercase;
    white-space: nowrap;
    font-kerning: none;
    font-variant-ligatures: none;
    text-rendering: geometricPrecision;
    transition: opacity 160ms ease-out;
    opacity: 0.74;
  }

  .site-header__link:hover {
    opacity: 0.9;
  }

  .site-header__link--brand,
  .site-header__link.is-active {
    opacity: 0.98;
  }

  .site-header__link--brand {
    justify-self: start;
  }

  .site-header__link--work {
    justify-self: center;
  }

  .site-header__link--information {
    justify-self: end;
  }

  .site-main {
    padding-top: var(--header-clearance);
  }

  @media (max-width: 40rem) {
    .site-header__nav {
      gap: 0.5rem;
      padding-top: 0.84rem;
      padding-bottom: 0.66rem;
    }

    .site-header__link {
      font-size: 0.74rem;
      letter-spacing: 0.084em;
    }
  }
</style>
