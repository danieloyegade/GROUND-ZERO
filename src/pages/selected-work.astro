---
import { getCollection } from "astro:content";
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
  title="Selected Work | GROUND ZERO"
  description="Selected work from the GROUND ZERO portfolio."
>
  <ProjectGrid
    projects={projects.map((project) => ({
      title: project.data.title,
      image: project.data.image,
      descriptor: project.data.descriptor,
      display: project.data.display,
    }))}
  />
</BaseLayout>
