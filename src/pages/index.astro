import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="GROUND ZERO"
  description="A minimal editorial portfolio with a restrained, image-led layout."
>
  <section class="px-6 pb-24 pt-28 sm:px-10 sm:pb-32 sm:pt-32 lg:px-14">
    <div class="mx-auto grid min-h-[calc(100vh-8rem)] max-w-[96rem] gap-16 border-t border-black/8 pt-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.6fr)] lg:items-end lg:pt-16">
      <div class="max-w-3xl space-y-8">
        <p class="text-[0.68rem] uppercase tracking-[0.34em] text-[var(--muted-foreground)]">
          Homepage
        </p>
        <h1 class="max-w-4xl text-4xl leading-[0.94] tracking-[-0.04em] sm:text-6xl lg:text-[5.6rem]">
          A restrained editorial shell for an image-led portfolio.
        </h1>
        <p class="max-w-xl text-base leading-8 text-[var(--muted-foreground)] sm:text-[1.05rem]">
          The visual system is intentionally spare at this stage: fixed navigation, calm spacing,
          controlled typography, and a warm off-white field that leaves room for the future intro
          sequence and project index.
        </p>
      </div>

      <div class="max-w-sm space-y-6 border-t border-black/8 pt-6 lg:border-t-0 lg:border-l lg:pl-10 lg:pt-0">
        <p class="font-serif text-2xl leading-tight text-[var(--page-foreground)] sm:text-[2rem]">
          Deliberate, spacious, and exacting.
        </p>
        <p class="text-sm leading-7 text-[var(--subtle-foreground)]">
          Satoshi carries the interface. Cormorant Garamond enters only where a softer editorial
          accent improves the rhythm.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
