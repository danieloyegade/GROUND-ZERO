---
import { getCollection } from "astro:content";
import IntroOverlay from "../components/IntroOverlay.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
  title="GROUND ZERO"
  description="A minimal editorial portfolio with a restrained, image-led layout."
>
  <IntroOverlay />

  <ProjectGrid
    projects={projects.map((project) => ({
      title: project.data.title,
      image: project.data.image,
      descriptor: project.data.descriptor,
      display: project.data.display,
    }))}
  />
</BaseLayout>
