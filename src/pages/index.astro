---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.slug.localeCompare(b.slug));

const floorLabels = [
  "EIGHTH FLOOR",
  "FOURTH FLOOR",
  "FIRST FLOOR",
  "GROUND FLOOR",
  "GROUND ZERO",
];
---

<BaseLayout
  title="GROUND ZERO"
  description="A minimal editorial portfolio with a restrained, image-led layout."
>
  <section class="border-b border-white/10 px-6 pb-16 pt-24 sm:px-8 sm:pb-24 sm:pt-28">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.35fr_0.9fr] lg:items-end">
      <div class="space-y-6">
        <p class="text-[0.68rem] uppercase tracking-[0.34em] text-stone-400">
          Intro Image
        </p>
        <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-stone-900">
          <img
            src="/images/intro-image.jpg"
            alt="Intro placeholder"
            class="aspect-[4/5] w-full object-cover"
            loading="eager"
          />
        </div>
      </div>

      <div class="space-y-8">
        <div class="space-y-3">
          <p class="text-[0.68rem] uppercase tracking-[0.34em] text-stone-400">
            Descent
          </p>
          <ul class="space-y-2 text-balance font-serif text-3xl leading-none text-stone-100 sm:text-4xl">
            {floorLabels.map((label) => <li>{label}</li>)}
          </ul>
        </div>
        <p class="max-w-md text-sm leading-7 text-stone-300">
          A restrained editorial homepage with a swipe-up transition implied through pacing,
          hierarchy, and stillness rather than motion-heavy effects.
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto flex max-w-7xl items-end justify-between gap-8 border-b border-white/10 pb-6">
      <div>
        <p class="text-[0.68rem] uppercase tracking-[0.34em] text-stone-400">
          Projects
        </p>
        <h1 class="mt-4 max-w-xl text-3xl font-medium tracking-tight text-white sm:text-5xl">
          Freeform editorial project studies.
        </h1>
      </div>
      <p class="hidden max-w-sm text-sm leading-7 text-stone-400 lg:block">
        Hover states stay restrained: subtle darkening, bottom-left titles, and no decorative
        animation libraries.
      </p>
    </div>

    <div class="mx-auto mt-10 grid max-w-7xl gap-6 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((project) => (
        <article class="group relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-stone-900">
          <img
            src={project.data.image}
            alt={project.data.title}
            class="aspect-[4/5] w-full object-cover transition-opacity duration-300 group-hover:opacity-70"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-80"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5">
            <div>
              <p class="text-[0.65rem] uppercase tracking-[0.3em] text-stone-300/80">
                {project.data.status}
              </p>
              <h2 class="mt-2 text-xl text-white">{project.data.title}</h2>
            </div>
            <p class="text-[0.65rem] uppercase tracking-[0.3em] text-stone-300/70">
              {project.slug}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
